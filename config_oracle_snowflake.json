{
  "project_name": "Oracle_to_Snowflake_Pipeline",
  "description": "ETL pipeline from Oracle database to Snowflake data warehouse",
  "source": {
    "type": "Oracle",
    "name": "Oracle Production Database"
  },
  "target": {
    "type": "Snowflake",
    "name": "Snowflake Data Warehouse"
  },
  "primary_key": "customer_id",
  "schema": {
    "customer_id": "integer",
    "customer_name": "string",
    "email": "string",
    "phone": "string",
    "address": "string",
    "city": "string",
    "country": "string",
    "created_date": "date",
    "last_updated": "timestamp"
  },
  "validation_rules": {
    "customer_id": {"required": true, "type": "integer", "min": 1},
    "customer_name": {"required": true, "type": "string", "min_length": 2},
    "email": {"required": true, "format": "email"},
    "phone": {"required": false, "type": "string"},
    "address": {"required": true, "type": "string"},
    "city": {"required": true, "type": "string"},
    "country": {"required": true, "type": "string"},
    "created_date": {"required": true, "type": "date"},
    "last_updated": {"required": true, "type": "timestamp"}
  },
  "etl_stages": [
    {"stage": "extraction", "enabled": true},
    {"stage": "transformation", "enabled": true},
    {"stage": "loading", "enabled": true}
  ]
}

